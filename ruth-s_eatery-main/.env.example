# Aiven MySQL connection. Use either AIVEN_URL or the separate MYSQL_* variables.
AIVEN_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:YOUR_PORT/defaultdb?ssl-mode=REQUIRED

# Alternative separate variables
# MYSQL_HOST=YOUR_HOST.aivencloud.com
# MYSQL_PORT=YOUR_PORT
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=YOUR_PASSWORD
# MYSQL_DATABASE=defaultdb

# App credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
DEFAULT_USER_PASSWORD=user123

# Render sets PORT automatically, but local server can use this.
PORT=3001
